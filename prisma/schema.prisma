// Sistema de gestión de gimnasio (multi-tenant)
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Comercio / gimnasio (tenant)
model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  active       Boolean  @default(true)
  address      String   @default("")
  cuit         String   @default("")
  lugarPago    String   @default("")
  fPagoAportes String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plans            Plan[]
  clients          Client[]
  employees        Employee[]
  users            User[]
  payments         Payment[]
  contents         Content[]
  contentReads     ContentRead[]
  contentDismissals ContentDismiss[]
  accessLogs       AccessLog[]
  employeeReceipts EmployeeReceipt[]
}

model Plan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          Float
  durationDays   Int
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  clients        Client[]

  @@index([organizationId])
}

model Client {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  documentId       String
  email            String?
  phone            String?
  birthDate        DateTime?
  address          String?
  emergencyContact String?
  notes            String?
  active           Boolean      @default(true)
  qrToken          String       @unique
  /// PIN hasheado para ingresar al portal / PWA del cliente
  portalPinHash    String?
  /// Último PIN emitido (solo visible en ficha admin; el login usa el hash)
  portalPin        String?
  /// Nivel de entrenamiento (filtra rutinas/dietas en el PWA). null = sin asignar
  trainingLevel    ContentLevel?
  membershipEndsAt DateTime?
  planId           String?
  plan             Plan?        @relation(fields: [planId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payments         Payment[]
  accessLogs       AccessLog[]
  contents         Content[]
  contentReads     ContentRead[]
  contentDismissals ContentDismiss[]

  @@unique([organizationId, documentId])
  @@index([organizationId])
}

enum ContentType {
  info
  rutina
  dieta
  aviso
}

enum ContentLevel {
  principiante
  intermedio
  avanzado
}

enum ContentGender {
  hombre
  mujer
  todos
}

/// Contenidos para el PWA del cliente (info, rutinas, dietas, avisos)
model Content {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ContentType    @default(info)
  title          String
  body           String
  /// null = visible para todos los clientes activos
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Filtros de plantilla (rutina/dieta); null en info/aviso
  level          ContentLevel?
  gender         ContentGender  @default(todos)
  daysPerWeek    Int?
  /// URL HTTPS (YouTube/Vimeo/directo); sin upload binario
  videoUrl       String?
  videoTitle     String?
  published      Boolean        @default(true)
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt    DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  reads          ContentRead[]
  dismissals     ContentDismiss[]

  @@index([organizationId])
  @@index([organizationId, type])
}

/// Lectura de un contenido por un cliente (para avisos de “nuevos”)
model ContentRead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentId      String
  content        Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([contentId, clientId])
  @@index([clientId])
  @@index([organizationId])
}

/// Oculta un contenido (info/aviso) en el portal del cliente sin borrarlo para todos
model ContentDismiss {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentId      String
  content        Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime     @default(now())

  @@unique([contentId, clientId])
  @@index([clientId])
  @@index([organizationId])
}

enum UserRole {
  ADMIN
  EMPLOYEE
  /// Plataforma: gestiona comercios (organizations) sin romper el tenant del staff
  SUPERADMIN
}

model User {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email            String       @unique
  passwordHash     String
  name             String
  role             UserRole     @default(EMPLOYEE)
  active           Boolean      @default(true)
  employeeId       String?      @unique
  employee         Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  paymentsRegistered Payment[]  @relation("PaymentRegisteredBy")
  paymentsVoided     Payment[]  @relation("PaymentVoidedBy")
  contentsCreated    Content[]
  employeeReceipts   EmployeeReceipt[] @relation("EmployeeReceiptRegisteredBy")

  @@index([organizationId])
}

model Employee {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  documentId       String
  email            String?
  phone            String?
  role             String
  salary           Float?
  hireDate         DateTime     @default(now())
  address          String?
  notes            String?
  /// CUIL del empleado (formato libre, ej. 20-12345678-9)
  cuil             String?
  /// Nº de legajo interno
  legajo           String?
  /// Categoría laboral (si vacío, se usa el cargo/rol)
  categoriaLaboral String?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User?
  receipts         EmployeeReceipt[]

  @@unique([organizationId, documentId])
  @@index([organizationId])
}

enum EmployeeReceiptStatus {
  draft
  signed
  sent
}

/// Recibo de sueldo / liquidación del empleado (historial + firma)
/// Modelo operativo al estilo anexo "recibo de sueldo" (no es asesoramiento legal/contable).
model EmployeeReceipt {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Sueldo neto a percibir
  amount           Float
  /// Sueldo bruto de la liquidación
  sueldoBruto      Float
  /// 1 = 1ª quincena, 2 = 2ª quincena, null = mensual
  quincena         Int?
  method           String                 @default("transferencia")
  periodFrom       DateTime
  periodTo         DateTime
  paidAt           DateTime               @default(now())
  notes            String?
  /// Snapshot de líneas empleador: [{concepto,unidad,base,monto}]
  employerLines    Json?
  /// Snapshot de líneas trabajador (haberes + descuentos)
  employeeLines    Json?
  status           EmployeeReceiptStatus  @default(draft)
  /// PNG data URL de la firma del empleado
  signatureData    String?
  signedAt         DateTime?
  signedName       String?
  /// Token público para ver/compartir el recibo (mail / WhatsApp)
  viewToken        String                 @unique
  emailSentAt      DateTime?
  whatsappOpenedAt DateTime?
  registeredById   String?
  registeredBy     User?                  @relation("EmployeeReceiptRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([employeeId, paidAt])
  @@index([organizationId])
}

enum PaymentMethod {
  efectivo
  transferencia
  mercadopago
}

enum PaymentStatus {
  pending
  confirmed
  cancelled
  rejected
}

enum PaymentSource {
  manual
  automatic
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount         Float
  method         PaymentMethod @default(efectivo)
  status         PaymentStatus @default(confirmed)
  source         PaymentSource @default(manual)
  periodFrom     DateTime
  periodTo       DateTime
  paidAt         DateTime?
  notes          String?
  reference      String?       // alias / concepto de transferencia o external_reference MP
  externalId     String?       // id de pago en Mercado Pago
  preferenceId   String?
  checkoutUrl    String?
  registeredById String?
  registeredBy   User?         @relation("PaymentRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  voidedById     String?
  voidedBy       User?         @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

model AccessLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  qrToken        String
  granted        Boolean
  reason         String
  scannedAt      DateTime      @default(now())

  @@index([organizationId])
}
