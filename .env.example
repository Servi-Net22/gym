# --- Supabase Postgres ---
# En Supabase: Connect → Transaction pooler (IPv4). Obligatorio en Vercel.
# Ejemplo (región puede ser aws-0-... o aws-1-...):
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (migraciones). Mismo host, puerto 5432:
DIRECT_URL="postgresql://postgres.XXXX:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# --- App / Vercel ---
# Ejemplo con dominio Servi-Net: https://gym.servi-net.com.ar
NEXT_PUBLIC_APP_URL="https://gym.servi-net.com.ar"
AUTH_SECRET="genera-un-secreto-largo-aleatorio"
NEXT_PUBLIC_APP_NAME="GymFlow"

# --- Resend (emails) ---
# Podés reutilizar la API key de servi-net.com.ar
RESEND_API_KEY="re_xxxxxxxx"
# Si el dominio ya está verificado en Resend:
RESEND_FROM="GymFlow <noreply@servi-net.com.ar>"

# --- Pagos / barrera ---
TRANSFER_ALIAS="gimnasio.tu.alias"
BARRIER_API_KEY="cambia-esta-clave"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_DEMO="true"
